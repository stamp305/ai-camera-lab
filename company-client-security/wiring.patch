+def _start_siren_setup():  # pragma: no cover - network side effect
+    """The siren setup page on 127.0.0.1:8767 (once; a taken port only turns it off)."""
+    if siren_setup is None:
+        return
+    try:
+        if not siren_setup.start():
+            logger.warning("[CLIENT_LOGIC] siren setup port busy, siren setup disabled")
+    except Exception as e:
+        logger.warning(f"[CLIENT_LOGIC] siren setup not started: {type(e).__name__}")
+
+
+def _admin_url() -> str:
+    """The first admin link this branch talks to (for the LAN route; nothing is sent there)."""
+    try:
+        return str((_sio.servers[0] or {}).get("url") or "")
+    except Exception:
+        return ""
+
+
+def _start_lan_probe():  # pragma: no cover - network side effect
+    """Serve the LAN check and report this branch's LAN address to the admin (now, then hourly)."""
+    global _lan_probe_started
+    if lan_probe is None:
+        return
+    try:
+        if not _lan_probe_started:
+            store_code = (lambda: str((live_agent.store_info() or {}).get("code") or "")) if live_agent else (lambda: "")
+            if not lan_probe.start(store_code):
+                logger.warning("[CLIENT_LOGIC] LAN check port busy, LAN check disabled")
+                return
+            lan_probe.start_reporter(lambda info: _sio.emit('branch_net', info), lambda: _sio.connected,
+                                     _admin_url())
+            _lan_probe_started = True
+        lan_probe.wake()
+    except Exception as e:
+        logger.warning(f"[CLIENT_LOGIC] LAN check not started: {type(e).__name__}")
+
+
+def _start_features_reporter():  # pragma: no cover - network side effect
+    """Tell the admin what this branch is ready for (live / alerts / siren), now and on change."""
+    if branch_features is None:
+        return
+    try:
+        branch_features.start_reporter(live_agent, lambda f: _sio.emit('branch_features', f),
+                                       lambda: _sio.connected)
+    except Exception as e:
+        logger.warning(f"[CLIENT_LOGIC] readiness report not started: {type(e).__name__}")
 
 
