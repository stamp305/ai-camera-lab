# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


# Runtime databases
*.db


# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Python
__pycache__/
.venv/
venv/

# Generated config / secrets (see client.py:_create_backend_env)
.env
.env.local
# สำเนา/ไฟล์ตรวจสอบของ .env — มีค่า DB_PASSWORD/DB_ROOT_PASSWORD จริงอยู่ข้างใน
.env.*
!.env.example
client_config.json
# secure_env.pyx เก็บ credential ทุกตัวแบบ XOR แล้ววาง KEY ไว้ไฟล์เดียวกัน
# ⇒ ถอดกลับได้ทันทีที่เปิดไฟล์ เท่ากับ commit .env ขึ้น git (เหตุผลเดียวกับ keyguard)
# แต่ละเครื่องสร้างเองด้วย generate_secure_env.py / setup_secure_env.py
data_service/configs/secure_env.pyx

# กุญแจ Fernet ของ DLC — ตัวจริงเป็น .so ที่คอมไพล์มาเพื่อไม่ให้กุญแจเป็น plaintext
# ส่วน keyguard.py เป็น shim ชั่วคราวที่เขียนกุญแจไว้ตรง ๆ
#
# รีโปนี้คือสิ่งที่เครื่องร้าน `git clone` ลงไป ⇒ commit ไฟล์นี้เมื่อไหร่ = แจกกุญแจ
# ที่ใช้ถอดรหัส `dlc_local/` ให้ทุกสาขาพร้อมกัน ซึ่งทำให้การเข้ารหัสไม่เหลือความหมาย
# (เหตุผลเดียวกับที่ `dlc_src/` ถูกกันไว้ด้านล่าง)
#
# วิธีเอาไปลงเครื่องใหม่: ก๊อปไฟล์จากสาขาที่มีอยู่แล้วผ่าน AnyDesk ไม่ใช่ผ่าน git
keyguard.py
keyguard.so
keyguard*.so
!.env.example
!frontend/.env.example

# Service logs (client.py + per-service log/)
logs/
log/

# Next.js build output (client.py rebuilds it on every boot)
frontend/.next/

# Encrypted service payload — pulled by the updater, not source
dlc_local/

# Playwright MCP session output
.playwright-mcp/

# Model weights / archives / array dumps
*.pt
*.pth
*.onnx
*.engine
*.npy
*.npz
*.zip

# Screenshots dropped at repo root
/*.png
/*.jpg

# Scratch experiments — local only, never committed
feature-experiments/

# ---------------------------------------------------------------------------
# ของที่ต้อง **ไม่** ไปถึงเครื่องร้าน
# ---------------------------------------------------------------------------
# รีโปนี้คือสิ่งที่เครื่องร้าน `git clone` ลงไป ทุกอย่างที่ commit = อยู่บนเครื่องลูกค้า
#
# `dlc_src/` คือซอร์ส **plaintext** ของ service ที่ตั้งใจส่งไปแบบเข้ารหัส (Fernet)
# ผ่าน DLC updater ถ้ามันติดไปกับ clone เครื่องร้านจะมีทั้งของเข้ารหัสและของถอดรหัส
# วางคู่กัน = การเข้ารหัสไม่เหลือความหมาย
# บ้านของซอร์ส DLC คือ `dlc_master/` ในรีโป ai-camera-admin (ฝั่งเซิร์ฟเวอร์)
#
# ⚠️ ผลข้างเคียงที่ต้องรู้: `dlc_src/*/tests/` ไม่ได้ถูกก๊อปขึ้น dlc_master ด้วย
# (สคริปต์ sync ตัด tests/ ทิ้งตามตรรกะเดียวกับ sync_dev.py) ⇒ เทสต์ 775 ตัวจะไม่มี
# บ้านใน git ที่ไหนเลย ต้องหาที่เก็บแยกก่อนล้างเครื่อง dev
dlc_src/

# สเปก/บันทึก/ADR — เป็นของทีมพัฒนา ไม่ใช่ของที่ต้องรันบนเครื่องร้าน
docs/

# สคริปต์ทดลอง + ชุดข้อมูลของ PoC — เครื่องร้านไม่ได้ใช้
poc/

# ก๊อป dlc_src -> dlc_local สำหรับ dev เท่านั้น บนเครื่องร้านไม่มี dlc_src ให้ก๊อป
sync_dev.py

# ข้อมูลจากเครื่องร้านที่ดาวน์โหลดมาทดสอบ — ไม่ใช่ซอร์ส และเป็นข้อมูลของสาขาจริง
# (`dlc_src/` ถูกกันทั้งก้อนแล้วด้านบน สองบรรทัดนี้คงไว้เผื่อวันที่เลิกกัน dlc_src/)
dlc_src/video/
dlc_src/models/
# น้ำหนักโมเดลที่ service โหลดเองตอนรัน — CONSUMER_MODEL_ROOT (default `models`)
# และ FACE_MODEL_DIR ลงมาที่นี่เหมือนกัน รวมเกือบ 800 MB ห้ามเข้า git
# (`*.pt`/`*.pth` ถูกกันอยู่แล้ว แต่ `.task` ของ mediapipe กับ `.mlpackage` ไม่ถูก)
/models/
# น้ำหนักโมเดลตรวจ mask (327 MB) — `face_service` โหลดเองจาก HuggingFace ตอนรัน
# ถ้าไฟล์ไม่มี (ดู dlc_master/face_service/main.py:116-130) จึงไม่ต้องอยู่ใน git
# เครื่องร้านที่ clone จะโหลดเองรอบแรก แล้วเก็บไว้ใช้ต่อ
ViT-FaceMask-Finetuned/
# วิดีโอชั้น A ที่ recorder เขียนลงเครื่อง — VIDEO_ROOT (default `video`)
/video/
# ผลลัพธ์ที่สร้างใหม่ได้เสมอจากวิดีโอ
embeddings/
analyzer_state/
*.det.jsonl.gz
# marker ว่า report_service ส่งวันไหนขึ้นส่วนกลางแล้ว — สร้างตอนรันบนเครื่องร้าน
# เป็นสถานะของเครื่องนั้น ไม่ใช่ซอร์ส ถ้าหลุดเข้า git เครื่องอื่นจะคิดว่าส่งไปแล้วทั้งที่ยัง
upload_state/

# ---------------------------------------------------------------------------
# Standalone-app architecture (bootstrap.py / client_logic.py) — build & runtime
# ---------------------------------------------------------------------------
# Cython build outputs — compiled artifacts never belong in git.
# `_secrets.py` (placeholder structure) IS committed; real key values live in
# each machine's `.env` (see _secrets.example.py). If a real-key copy exists
# locally it must never be pushed.
*.so
*.c
_secrets.py

# Local virtualenv / bundled runtime / build outputs
python_env/
build/
.claude/
release/
build_test_sandbox/
bin/
db_support/
.pytest_cache/

# Update/rollback scratch state created on the shop machine
temp_update/
backup_*/

# Model weights not covered by *.pt/*.pth above
*.task
*.mlpackage

# macOS junk beyond .DS_Store
*.swp
.stale_so_backup_*/

# Runtime data written by data_service: uploaded floorplan images and the
# evidence crops each detection service saves. Machine-local, never source.
data_service/static/logs/
data_service/static/images/floorplans/

# Runtime crops written by cus_emp/rate services
cusemp_rate_log/

# Version baked in by the build farm (worker.run_payload_job) — never commit it
_build_info.py
_build_info*.so
_build_info.c

# Notes for the coding assistant; kept locally, not in the repo.
CLAUDE.md

# Generated by tools/pack_ui_assets.py during a build, removed after it
frontend_web/assets.bin
